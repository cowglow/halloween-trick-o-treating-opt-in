# The server's .env, next to docker-compose.prod.yml (docs/SELF_HOSTING.md).
# Keep it private: chmod 600 .env. The teardown deletes it after the event.

# The API's host name; Caddy gets its HTTPS certificate for it.
API_DOMAIN=halloween-api.example.org
# Where the map app is served, for invite and sign-in links and CORS.
CLIENT_ORIGIN=https://halloween.example.org

# The database (only reachable inside Docker). Pick a long random password.
POSTGRES_USER=halloween
POSTGRES_PASSWORD=change-me-to-something-long-and-random
POSTGRES_DB=halloween

# Signs sessions: `openssl rand -hex 32`.
SPACE_JWT_SECRET=

# Email through Resend (docs/RESEND_EMAIL_SETUP.md). Without these the API
# only logs the emails instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=Halloween map <login@mail.example.org>
# Replies to the thank-you email go here.
THANK_YOU_REPLY_TO=you@example.org

# Optional: overrides community.json's eventEndAt.
# EVENT_END_AT=2027-11-01T00:00:00+01:00
