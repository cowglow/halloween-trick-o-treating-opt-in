# Config for the Hetzner provisioning helpers (scripts/ionos-dns-upsert.sh, the
# hcloud commands and gh secret set commands in docs/HETZNER_DEPLOY.md and
# docs/HETZNER_REBUILD.md). Copy to deploy/hetzner/config.env (gitignored) and
# fill in real values, then before running any of them:
#   set -a; source deploy/hetzner/config.env; set +a
#
# Real secrets (IONOS_API_KEY) are deliberately NOT in this file —
# export them directly in your shell for the session instead, the same
# treatment as every other credential. Don't add them here.

GITHUB_REPO=cowglow/halloween-trick-o-treating-opt-in
DOMAIN=cowglow.io
# Example only - the API domain is still to be decided (TASK.md). It must
# match the API_DOMAIN repository variable.
SUBDOMAIN=halloween-api
CLIENT_ORIGIN=https://halloween.cowglow.io
# The first participant, for `pnpm seed:space` (SEED_SPACE_PARTICIPANT_EMAIL).
SEED_SPACE_PARTICIPANT_EMAIL=you@example.com

HETZNER_IMAGE=ubuntu-24.04
HETZNER_SERVER_TYPE=cx23
HETZNER_LOCATION=fsn1
