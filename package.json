{
  "name": "halloween-trick-o-treating-opt-in",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "scripts/dev-cert-ensure.sh",
    "dev": "vite --host --port 3000 --strictPort",
    "dev:https": "pnpm dev",
    "dev:lan": "VITE_API_URL=/api pnpm dev",
    "dev:ai": "claude --dangerously-skip-permissions",
    "dev:up": "pnpm backend:up && pnpm dev",
    "dev:down": "pnpm backend:down",
    "docker:dev": "docker compose run --service-ports frontend bash",
    "build": "tsc && vite build",
    "lint": "eslint frontend e2e --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "format": "prettier . --write",
    "images:whatsapp": "node scripts/whatsapp/render.mjs",
    "test": "vitest --coverage",
    "test:e2e": "playwright test -c playwright.spaces.config.ts",
    "test:e2e:spaces": "playwright test -c playwright.spaces.config.ts",
    "test:e2e:spaces:offline": "playwright test -c playwright.spaces-offline.config.ts",
    "test:e2e:site": "playwright test -c playwright.site.config.ts",
    "dev:site": "VITE_SITE=true vite",
    "build:site": "VITE_SITE=true vite build",
    "backend:up": "docker compose up -d --build db api adminer && pnpm backend:migrate",
    "backend:down": "docker compose down",
    "backend:logs": "docker compose logs -f api",
    "backend:migrate": "docker compose exec api pnpm prisma:deploy",
    "backend:seed": "docker compose exec -e SEED_SPACE_PARTICIPANT_EMAIL -e SEED_SPACE_SLUG -e SEED_SPACE_NAME api pnpm seed:space"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@picocss/pico": "2.1.1",
    "@protomaps/basemaps": "^5.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vis.gl/react-maplibre": "^8.1.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "maplibre-gl": "6.16.0",
    "pmtiles": "4.5.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf",
  "pnpm": {
    "overrides": {
      "@eslint/plugin-kit": "0.3.5",
      "js-yaml": "4.3.2",
      "@rollup/pluginutils": "5.4.0",
      "ajv": "6.15.0",
      "flatted": "3.4.2",
      "lodash": "4.18.1",
      "ws": "8.21.0",
      "@babel/core": "7.29.7",
      "postcss": "8.5.23",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.7",
      "yaml@>=1.0.0 <1.10.3": "1.10.3",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "vitest@<4.1.11": "4.1.11",
      "nanoid": "3.3.19",
      "browserslist": "4.28.9",
      "@humanfs/node": "0.16.8"
    }
  }
}
