{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* TypeScript 6 no longer includes @types packages by default; the unit tests use node:fs */
    "types": ["node"],
    /* Linting */
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    /* Imports are absolute from frontend/ (e.g. "ports/pages/..."), see CLAUDE.md */
    "paths": {
      "community/*": [
        "./community/*"
      ],
      "*": [
        "./frontend/*"
      ]
    }
  },
  "include": [
    "frontend",
    "community/*.json"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
